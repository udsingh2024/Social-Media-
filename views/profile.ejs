<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.name %> | Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen flex flex-col items-center py-10">

  <!-- Header -->
  <div class="w-full max-w-3xl flex justify-between items-center mb-8 px-4">
    <!-- <div class="flex item-start gap-3"> -->
      <div class="flex-col">
        <div class="w-20 h-20 rounded-md overflow-hidden flex-col">
          <img class="w-full h-full object-cover rounded-2xl" src="./images/uploads/<%= user.profile_pic %>" alt="profile pic">
        </div>
          <form action="/uploadDp" method="post">
            <!-- <input type="submit" class="text-blue-400 font-semibold text-sm" value="Edit DP"> -->
             <button type="submit" class="bg-yellow-500 rounded-md text-black px-3 py-0.5 font-bold text-sm mt-1 ">Edit Dp</button>
          </form>
      </div>
      <h1 class="text-2xl font-semibold">
        Hello, <span class="text-blue-400"><%= user.name %></span> 👋
      </h1>

    <!-- </div> -->
    <form action="/logout" method="get">
      <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-medium px-4 py-2 rounded-lg">
        Logout
      </button>
    </form>
  </div>

  <!-- Create Post Section -->
  <div class="w-full max-w-3xl bg-gray-800 rounded-2xl shadow-md p-6 mb-10">
    <form action="/post" method="POST" class="flex flex-col space-y-4">
      <textarea 
        name="content" 
        placeholder="What's on your mind?" 
        class="w-full bg-gray-700 text-gray-200 placeholder-gray-400 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none h-28"
      ></textarea>
      <button 
        type="submit" 
        class="self-end bg-blue-500 hover:bg-blue-600 text-white px-5 py-2 rounded-lg font-medium transition duration-200"
      >
        Create New Post
      </button>
    </form>
  </div>

  <!-- User Posts -->
  <div class="w-full max-w-3xl">
    <h2 class="text-lg font-semibold mb-4 text-gray-300">Your Posts</h2>

      <% if (!posts || posts.length === 0) { %>
      <p class="text-gray-500">You haven't posted anything yet.</p>
      <% } else { %>
      <% posts.reverse().forEach(post => { %>
        <div class="bg-gray-800 rounded-xl p-4 mb-4 shadow-md">
          <p class="text-blue-400 font-medium">@<%= user.username %></p>
          <p class="mt-2 text-gray-200"><%= post.content %></p>
          <small class="mt-2 inline-block"><%= post.likes.length %> likes</small>
          <div class="flex items-center gap-4 mt-3 text-sm text-gray-400">
            <a href="/like/<%= post._id %>" class="hover:text-blue-400 transition">
              <%= post.likes.includes(user._id) ? 'Unlike' : 'Like' %>
              <!-- <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %> -->
            </a>
            <a href="/edit/<%= post._id %>" class="hover:text-yellow-400 transition">Edit</a>
            <a href="/delete/<%= post._id %>" class="hover:text-red-400 transition">Delete</a>
          </div>
        </div>
      <% }) %>
      <% } %>

  </div>

  <script>
    const upload = (req) =>{

    }
  </script>
</body>
</html>
